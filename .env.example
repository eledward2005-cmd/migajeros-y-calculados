# Copia este archivo como .env y ajusta los valores.

# Puerto del servidor
PORT=3000

# Base de datos: sqlite (por defecto, no requiere instalar nada) o mssql (SQL Server)
DB_DRIVER=sqlite

# --- Solo para SQL Server (DB_DRIVER=mssql) ---
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=MigajerosCalculados
DB_USER=sa
DB_PASSWORD=TuClaveSegura123
# true si usas Azure SQL
DB_ENCRYPT=false
# true para aceptar el certificado autofirmado de una instalación local
DB_TRUST_CERT=true

# Clave para firmar las sesiones (si no la defines se genera una en data/.session-secret)
SESSION_SECRET=

# Clave para ver las preguntas del formulario en /admin/preguntas?token=...
ADMIN_TOKEN=cambia-esta-clave
