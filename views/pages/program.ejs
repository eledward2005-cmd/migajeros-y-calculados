<%- include('../partials/top') %>
<%
  const shareText = `¡Súmate a ${program.title}!`;
  const enc = encodeURIComponent;
  const base = `/p-gina-de-programas/${program.id}`;
%>
<section class="program-hero" style="--area:<%= area.color %>;--area-soft:<%= area.soft %>">
  <div class="program-hero__inner">
    <nav class="breadcrumbs" aria-label="Ruta">
      <a href="/">Inicio</a><span aria-hidden="true">›</span><a href="/challenges">Cursos</a><span aria-hidden="true">›</span><a href="<%= area.page %>"><%= area.name %></a><span aria-hidden="true">›</span><span aria-current="page">Curso</span>
    </nav>
    <div class="program-hero__grid">
      <div>
        <span class="area-pill area-pill--light"><%= area.name %></span>
        <h1 class="program-hero__title"><%= program.title %></h1>
        <p class="program-hero__text"><%= program.details %></p>
        <ul class="program-hero__meta">
          <li><strong><%= stepCount %></strong> pasos</li>
          <li><strong><%= program.sections.length %></strong> temas</li>
          <li><strong>A tu ritmo</strong></li>
          <li><strong><%= program.price %></strong></li>
        </ul>
        <p class="program-hero__reward">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor"/><path d="M5 8.2l2 2 4-4.2" fill="none" stroke="currentColor"/></svg>
          Todos los que completen todos los pasos del programa obtendrán una insignia.
        </p>
      </div>
      <img class="program-hero__cover" src="<%= program.image %>" alt="<%= program.imageAlt %>" width="1200" height="675">
    </div>
  </div>
</section>

<div class="program-layout">
  <div class="program-main">
    <section class="card">
      <h2 class="card__title">Contenido del curso</h2>
      <ol class="syllabus">
        <% program.sections.forEach((sec, i) => { const n = sec.steps.filter(s => completed.includes(s.id)).length; %>
          <li class="syllabus__item">
            <details<%= i === 0 ? ' open' : '' %>>
              <summary>
                <span class="syllabus__num"><%= i + 1 %></span>
                <span class="syllabus__title"><%= sec.title %></span>
                <span class="syllabus__count"><%= enrolled ? `${n}/${sec.steps.length}` : `${sec.steps.length} pasos` %></span>
              </summary>
              <ul class="syllabus__steps">
                <% sec.steps.forEach(st => { const done = completed.includes(st.id); %>
                  <li class="<%= done ? 'is-done' : '' %>">
                    <span class="syllabus__type" aria-hidden="true"><%= st.type === 'VIDEO' ? '▶' : (st.title.startsWith('Idea') ? '💡' : '✎') %></span>
                    <% if (enrolled) { %><a href="<%= base %>/participante?paso=<%= st.id %>"><%= st.title %></a><% } else { %><span><%= st.title %></span><% } %>
                    <% if (done) { %><span class="syllabus__check" aria-label="completado">✓</span><% } %>
                  </li>
                <% }) %>
              </ul>
            </details>
          </li>
        <% }) %>
      </ol>
    </section>

    <section class="card">
      <h2 class="card__title">Sobre</h2>
      <p><%= program.details %></p>
    </section>
  </div>

  <aside class="program-side">
    <div class="card card--sticky">
      <p class="program-side__price">Precio <strong><%= program.price %></strong></p>
      <% if (enrolled) { %>
        <div class="program-side__progress">
          <div class="ring" style="--p:<%= progress.percent %>;--ring:<%= area.color %>" role="img" aria-label="Avance: <%= progress.percent %>%"><span><%= progress.percent %>%</span></div>
          <p><strong><%= progress.done %> de <%= progress.total %> pasos</strong><br><span class="muted">completados</span></p>
        </div>
        <a class="btn btn--block" href="<%= base %>/participante"><%= progress.finished ? 'Repasar el programa' : 'Continuar el programa' %></a>
      <% } else { %>
        <form action="/api/programas/<%= program.id %>/unirse" method="post">
          <button class="btn btn--block btn--lg" type="submit">Únete</button>
        </form>
        <% if (!member) { %><p class="muted small center">Necesitas una cuenta gratuita para guardar tu avance.</p><% } %>
      <% } %>
      <div class="program-side__badge">
        <span class="badge-pill" style="--badge-bg:<%= program.badge.backgroundColor %>;--badge-fg:<%= program.badge.textColor %>">★ <%= program.badge.title %></span>
        <p class="muted small"><%= program.badge.description %></p>
      </div>
      <h2 class="program-side__h">Compartir</h2>
      <ul class="share">
        <li><a href="https://facebook.com/sharer/sharer.php?u=<%= enc(shareUrl) %>&quote=<%= enc(shareText) %>" target="_blank" rel="noopener" aria-label="Compartir en Facebook">
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M12 2a10 10 0 00-1.6 19.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0012 2z" fill="currentColor"/></svg></a></li>
        <li><a href="https://x.com/intent/post?text=<%= enc(shareText) %>&url=<%= enc(shareUrl) %>" target="_blank" rel="noopener" aria-label="Compartir en X">
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M4 4l6.8 9L4.3 20H6l5.6-6 4.5 6H20l-7.1-9.5L19.1 4h-1.7l-5.2 5.6L8 4z" fill="none" stroke="currentColor" stroke-width="1.3"/></svg></a></li>
        <li><a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= enc(shareUrl) %>" target="_blank" rel="noopener" aria-label="Compartir en LinkedIn">
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" fill="currentColor"/><path d="M7.5 10v6.5M7.5 7.3v.1M11 16.5V10m0 3c0-1.7 1-3 2.6-3 1.4 0 2.2 1 2.2 2.8v3.7" stroke="#fff" stroke-width="1.6" fill="none"/></svg></a></li>
        <li data-js-only hidden><button type="button" class="copy-link" data-copy="<%= shareUrl %>" aria-label="Copiar enlace">
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1M14 10a4 4 0 00-5.7 0l-3 3a4 4 0 005.7 5.7l1-1" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></button>
          <span class="copy-feedback" role="status" aria-live="polite"></span></li>
      </ul>
    </div>
  </aside>
</div>
<%- include('../partials/bottom') %>
