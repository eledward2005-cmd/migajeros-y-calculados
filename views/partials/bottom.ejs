          <% } %>
          <li><a href="/ayudas-ucc#duda">¿Tienes una duda?</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p><%= site.copyright %></p>
      <p><%= site.tagline %></p>
    </div>
  </footer>
  <script src="/js/main.js?v=<%= assetV.js %>" defer></script>
