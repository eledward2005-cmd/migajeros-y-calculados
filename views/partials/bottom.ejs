        <h2 class="footer-h">Navegación</h2>
        <ul>
          <% site.nav.forEach(item => { %><li><a href="<%= item.href %>" class="<%= item.key === active ? 'is-current' : '' %>"><%= item.label %></a></li><% }) %>
        </ul>
      </nav>
      <div class="footer-col">
